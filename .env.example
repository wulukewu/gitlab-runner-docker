# ╔═══════════════════════════════════════════╗
# ║   GitLab Runner Docker — Environment      ║
# ║   Copy this file to .env and fill in.      ║
# ╚═══════════════════════════════════════════╝

# ── Required ─────────────────────────────────
# Runner authentication token (from GitLab UI)
# Supports multiple runners: comma-separated tokens
# e.g. RUNNER_TOKEN=glrt-aaa,glrt-bbb
RUNNER_TOKEN=glrt-xxxxx

# Personal Access Token with read_api scope (for dashboard)
GITLAB_API_TOKEN=glpat-xxxxx

# Optional: Limit dashboard to specific GitLab Group ID
# GITLAB_GROUP_ID=12345678

# ── Optional (defaults shown) ───────────────
# GITLAB_URL=https://gitlab.com
# RUNNER_NAME=gitlab-runner
# RUNNER_EXECUTOR=shell          # Use "docker" for local dev with Docker socket
# RUNNER_CONCURRENT=4            # Max parallel jobs across all runners
# RUNNER_DOCKER_IMAGE=docker:24.0.5
# RUNNER_DOCKER_PRIVILEGED=true
# DASHBOARD_PORT=8080
